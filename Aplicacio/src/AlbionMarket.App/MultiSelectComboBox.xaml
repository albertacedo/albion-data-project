<UserControl x:Class="AlbionMarket.App.MultiSelectComboBox" x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="90">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Indicator" Width="15" Height="15" Margin="2,0,7,0"
                                    Background="#0C0E13" BorderBrush="#566176" BorderThickness="1"
                                    CornerRadius="2" VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 2,7 L 6,11 L 13,3" Stroke="White"
                                      StrokeThickness="2" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Background" Value="#24406B"/>
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#4C8DFF"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Indicator" Property="BorderBrush" Value="#4C8DFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="Button" Content="{Binding Summary, ElementName=root}"
                Click="Button_Click" Padding="8,3" HorizontalContentAlignment="Left"
                Background="#0C0E13" Foreground="{StaticResource TextBrush}"
                BorderBrush="{StaticResource BorderBrush2}"/>
        <Popup x:Name="Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Button}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="4" Padding="5" MinWidth="150">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Options, ElementName=root}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}" Background="Transparent"
                                          Padding="5,4" Margin="1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
