<Window x:Class="AlbionMarket.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Albion Market" Height="760" Width="1240"
        MinHeight="600" MinWidth="980"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ALBION" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="MARKET" FontSize="18" FontWeight="Bold" Margin="6,0,14,0"/>
                    <Border Background="#1E2433" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="RegionLabel" Text="Europe" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Iniciant..." HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="8,8">

            <!-- ============================ OPORTUNITATS ============================ -->
            <TabItem Header="Oportunitats">
                <Grid Margin="8,10,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Actualitza ara" Click="Refresh_Click" Background="#24406B"/>
                        <TextBlock Text="ROI mínim" VerticalAlignment="Center" Margin="18,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="MinRoiBox" Width="55" Text="10"/>
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,14,0" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="Antiguitat màx." VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="MaxAgeBox" Width="55" Text="48"/>
                        <TextBlock Text="h" VerticalAlignment="Center" Margin="4,0,14,0" Foreground="{StaticResource MutedBrush}"/>
                        <CheckBox x:Name="ListedCheck" Content="Incloure vendes listades" IsChecked="True"
                                  Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="FlipsCountText" Text="" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding Flips}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding ItemId}" Width="175"/>
                            <DataGridTextColumn Header="NOM" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Q" Binding="{Binding Quality}" Width="35"/>
                            <DataGridTextColumn Header="COMPRA A" Binding="{Binding BuyCity}" Width="110"/>
                            <DataGridTextColumn Header="PAGUES" Binding="{Binding BuyPrice, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="VEN A" Binding="{Binding SellCity}" Width="110"/>
                            <DataGridTextColumn Header="REPS" Binding="{Binding InstantSellPrice, StringFormat={}{0:N0}}" Width="80"/>
                            <DataGridTextColumn Header="NET/UT" Binding="{Binding InstantNetProfit, StringFormat={}{0:N0}}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding InstantBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ROI" Binding="{Binding InstantRoiPercent, StringFormat={}{0:0.0}%}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding InstantBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="NET LISTAT" Binding="{Binding ListedNetProfit, StringFormat={}{0:N0}}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ListedBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ROI LISTAT" Binding="{Binding ListedRoiPercent, StringFormat={}{0:0.0}%}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding ListedBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="EDAT" Binding="{Binding WorstAgeHours, StringFormat={}{0:0}h}" Width="50"/>
                            <DataGridTextColumn Header="FONT" Binding="{Binding Source}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================================ PREUS ================================ -->
            <TabItem Header="Preus">
                <Grid Margin="8,10,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ItemSearchBox" Width="240" Text="T4_BAG"/>
                        <Button Content="Consultar" Click="Search_Click" Margin="8,0,0,0"/>
                        <TextBlock Text="ID exacte de l'item (p. ex. T4_BAG, T5_ORE, T6_MAIN_SWORD@2)"
                                   VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding Prices}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding ItemId}" Width="190"/>
                            <DataGridTextColumn Header="CIUTAT" Binding="{Binding City}" Width="130"/>
                            <DataGridTextColumn Header="VENDA MÍN (tu compres)" Binding="{Binding SellPriceMin, StringFormat={}{0:N0}}" Width="170"/>
                            <DataGridTextColumn Header="DATA" Binding="{Binding SellDateText}" Width="140"/>
                            <DataGridTextColumn Header="COMPRA MÀX (tu vens)" Binding="{Binding BuyPriceMax, StringFormat={}{0:N0}}" Width="180"/>
                            <DataGridTextColumn Header="DATA" Binding="{Binding BuyDateText}" Width="140"/>
                            <DataGridTextColumn Header="FONT" Binding="{Binding Source}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- =============================== SNIFFER =============================== -->
            <TabItem Header="Sniffer local">
                <Grid Margin="8,10,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="ClientButton" Content="Iniciar client" Click="Client_Click" Background="#24406B"/>
                        <Button x:Name="NatsButton" Content="Connectar NATS" Click="Nats_Click" Margin="8,0,0,0"/>
                        <Button Content="Importa dades de l'API" Click="Refresh_Click" Margin="8,0,0,0"/>
                        <TextBlock x:Name="SnifferStatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PETICIONS HTTP" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="IngestRequestsText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="ORDRES REBUDES" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="IngestOrdersText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MISSATGES NATS" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="NatsCountText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="ORDRES A LA BD" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="DbOrdersText" Text="0" FontSize="20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <DataGrid Grid.Row="2" Style="{StaticResource GridStyle}" ItemsSource="{Binding Orders}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HORA" Binding="{Binding TimeText}" Width="80"/>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding ItemId}" Width="190"/>
                            <DataGridTextColumn Header="CIUTAT" Binding="{Binding City}" Width="120"/>
                            <DataGridTextColumn Header="TIPUS" Binding="{Binding Side}" Width="80"/>
                            <DataGridTextColumn Header="PREU" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="100"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Amount}" Width="60"/>
                            <DataGridTextColumn Header="FONT" Binding="{Binding Source}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ CONFIGURACIÓ ============================ -->
            <TabItem Header="Configuració">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,10,8,0">
                    <Grid Width="760" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Servidor" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="RegionCombo" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Taxa de mercat (%)" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TaxBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Setup fee (%)" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SetupBox" Width="80" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Inversió màxima (0 = sense límit)" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxInvestBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Ruta del client" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ClientPathBox" Margin="0,0,0,10"/>

                        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="AlsoPublicCheck"
                                  Content="També enviar les meves dades al projecte públic (AODP)"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                        <CheckBox Grid.Row="6" Grid.Column="1" x:Name="AutoStartCheck"
                                  Content="En obrir l'app: client local en segon pla i NATS connectat"
                                  Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Llista de seguiment" VerticalAlignment="Top" Margin="0,4,0,10"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="WatchlistBox" Height="90" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Port d'ingesta" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="PortText" Text="5099" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"/>

                        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,10">
                            <Button Content="Desar" Click="Save_Click" Background="#24406B"/>
                            <Button Content="Sincronitzar catàleg d'items" Click="SyncItems_Click" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,8,0,0"
                                   Text="El client local s'engega sense finestra (albiondata-client.exe -i http://localhost:5099 -nogui) i envia les dades a aquesta app. Si actives l'enviament públic, també rebrà el projecte AODP (mateixes dades, cap cost)."/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Log -->
        <Border Grid.Row="2" Background="#0B0D12" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text=" REGISTRE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="12,6,0,2"/>
                <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Foreground="#9FB0C8" FontFamily="Consolas" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Margin="12,0,12,8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
